---
import Header from '../components/Header.tsx';
import Footer from '../components/Footer.tsx';

interface Props {
  title?: string;
  description?: string;
  currentLang?: string;
  dir?: 'ltr' | 'rtl';
}

const {
  title = 'Islamic Online - Complete Islamic Digital Companion & Tools',
  description = 'Explore verified Al-Quran chapters, authentic Hadith collections, accurate daily prayer schedules, Qibla direction, Zakat calculation, and digital Dhikr tools across 10 global languages.',
  currentLang = 'en',
  dir = ['ar', 'ur'].includes(currentLang) ? 'rtl' : 'ltr',
} = Astro.props;
---

<!doctype html>
<html lang={currentLang} dir={dir} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    {/* SEO Meta Tags */}
    <title>{title}</title>
    <meta name="description" content={description} />

    {/* Google Search Console Verification & AdSense Platform Meta Tags */}
    <meta name="google-site-verification" content="OqhGdJ_aNXti-vQ-L4nOPadp7cBUMCbDlnKy21nQE3c" />
    <meta name="google-adsense-platform-account" content="ca-host-pub-1556223355139109" />
    <meta name="google-adsense-platform-domain" content="blogspot.com" />

    {/* Global Google AdSense Script */}
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9372551067994918" crossorigin="anonymous"></script>

    {/* AMP Auto Ads Script */}
    <script async custom-element="amp-auto-ads" src="https://cdn.ampproject.org/v0/amp-auto-ads-0.1.js"></script>

    {/* Global CSS Stylesheet */}
    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>
  <body class="bg-gray-50 text-gray-900 dark:bg-gray-950 dark:text-gray-100 antialiased min-h-screen flex flex-col justify-between selection:bg-emerald-500 selection:text-white">
    
    {/* AMP Auto Ads Container */}
    <amp-auto-ads type="adsense" data-ad-client="ca-pub-9372551067994918"></amp-auto-ads>

    {/* Header Navigation with Language Selector & Ad Banner */}
    <Header client:load currentLang={currentLang} />

    {/* Main Page Slot Content */}
    <main class="flex-1">
      <slot />
    </main>

    {/* Comprehensive Multi-Column Footer */}
    <Footer />

  </body>
</html>
