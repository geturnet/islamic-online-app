---
import Header from '../../components/Header.tsx';
import Footer from '../../components/Footer.tsx';
import AdSlot from '../../components/AdSlot.tsx';
import '../../styles/global.css';

const duas = [
  { title: 'Morning remembrance', arabic: 'أَصْبَحْنَا وَأَصْبَحَ الْمُلْكُ لِلَّهِ', transliteration: 'Asbahna wa asbahal-mulku lillah', meaning: 'We have entered the morning and the dominion belongs to Allah.' },
  { title: 'Before eating', arabic: 'بِسْمِ اللَّهِ', transliteration: 'Bismillah', meaning: 'In the name of Allah.' },
  { title: 'After eating', arabic: 'الْحَمْدُ لِلَّهِ الَّذِي أَطْعَمَنَا', transliteration: 'Alhamdulillahil-ladhi at’amana', meaning: 'Praise be to Allah who fed us.' },
  { title: 'Seeking forgiveness', arabic: 'رَبِّ اغْفِرْ لِي وَتُبْ عَلَيَّ', transliteration: 'Rabbighfir li wa tub ‘alayya', meaning: 'My Lord, forgive me and accept my repentance.' },
  { title: 'For knowledge', arabic: 'رَبِّ زِدْنِي عِلْمًا', transliteration: 'Rabbi zidni ‘ilma', meaning: 'My Lord, increase me in knowledge.' },
  { title: 'When travelling', arabic: 'سُبْحَانَ الَّذِي سَخَّرَ لَنَا هَذَا', transliteration: 'Subhanal-ladhi sakhkhara lana hadha', meaning: 'Glory be to Him who has subjected this to us.' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="A collection of everyday duas with Arabic, transliteration and English meaning." />
    <title>Daily Duas and Supplications | Islamic Online</title>
  </head>
  <body class="min-h-screen bg-gray-50 text-gray-900">
    <Header client:load currentLang="en" />
    <main class="mx-auto max-w-7xl space-y-8 px-4 py-10">
      <header class="max-w-3xl">
        <p class="font-semibold uppercase tracking-widest text-emerald-700">Daily worship</p>
        <h1 class="mt-2 text-4xl font-extrabold text-emerald-950">Duas for everyday life</h1>
        <p class="mt-3 text-gray-600">Read the Arabic, use the transliteration as a guide, and reflect on the meaning. Check a trusted teacher or source for detailed rulings and references.</p>
      </header>
      <AdSlot position="in-article" slotId="1222556839" />
      <div class="grid gap-5 md:grid-cols-2">
        {duas.map((dua) => (
          <article class="rounded-2xl border border-emerald-100 bg-white p-6 shadow-sm">
            <h2 class="font-bold text-emerald-900">{dua.title}</h2>
            <p lang="ar" dir="rtl" class="my-5 text-right text-3xl leading-loose text-emerald-800">{dua.arabic}</p>
            <p class="font-medium">{dua.transliteration}</p>
            <p class="mt-2 text-sm leading-6 text-gray-600">{dua.meaning}</p>
          </article>
        ))}
      </div>
    </main>
    <Footer />
  </body>
</html>
