---
import Header from '../../components/Header.tsx';
import Footer from '../../components/Footer.tsx';
import Sidebar from '../../components/Sidebar.tsx';
import HadithIndexWidget from '../../components/HadithIndexWidget.tsx';
import AdSlot from '../../components/AdSlot.tsx';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Hadith Collections (Kutub al-Sittah) - Islamic Online</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>
  <body>
    <Header currentLang="en" />

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <div class="flex flex-col lg:flex-row gap-8">
        
        <!-- Main Content Area -->
        <div class="flex-1 space-y-8">
          <div class="text-center md:text-left bg-gradient-to-r from-emerald-900 to-emerald-700 text-white p-8 rounded-3xl shadow-lg">
            <h1 class="text-3xl md:text-4xl font-extrabold mb-3">
              Authentic Hadith Collections (الحديث الشريف)
            </h1>
            <p class="text-emerald-100 text-sm md:text-base max-w-2xl leading-relaxed">
              Explore the sayings, actions, and approvals of Prophet Muhammad (PBUH) compiled across the major canonical books of Hadith (Kutub al-Sittah).
            </p>
          </div>

          <!-- Interactive Hadith Index Widget -->
          <HadithIndexWidget client:load />

          <div class="article-content bg-white dark:bg-gray-900 p-6 rounded-2xl shadow-sm border border-emerald-100 dark:border-emerald-900">
            <h2>The Importance of Hadith in Islamic Jurisprudence</h2>
            <p>Hadith represents the second primary source of Islamic law (Sharia) after the Holy Quran. It provides detailed explanations of Quranic verses, practical demonstrations of worship, and timeless moral guidance.</p>
            
            <div class="my-6">
              <AdSlot position="in-article" slotId="1222556839" />
            </div>

            <h3>Classification of Hadith</h3>
            <ul>
              <li><strong>Sahih (Authentic):</strong> Narrations with continuous chains of trustworthy transmitters and no defects.</li>
              <li><strong>Hasan (Good):</strong> Reliable narrations where memory precision is slightly lesser than Sahih.</li>
              <li><strong>Da'if (Weak):</strong> Narrations failing to meet the strict criteria of authenticity.</li>
            </ul>
          </div>
        </div>

        <!-- Sidebar Area -->
        <Sidebar />

      </div>
    </main>

    <Footer />
  </body>
</html>
