---
import Header from '../../components/Header.tsx';
import Footer from '../../components/Footer.tsx';
import AdSlot from '../../components/AdSlot.tsx';
import '../../styles/global.css';
const base = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Find links to IslamicFinder news and trusted Muslim community updates." />
    <title>Islamic News and Updates | Islamic Online</title>
  </head>
  <body class="min-h-screen bg-gray-50 text-gray-900">
    <Header client:load currentLang="en" />
    <main class="mx-auto max-w-4xl space-y-8 px-4 py-10">
      <header>
        <p class="font-semibold uppercase tracking-widest text-emerald-700">News and updates</p>
        <h1 class="mt-2 text-4xl font-extrabold text-emerald-950">IslamicFinder News</h1>
        <p class="mt-3 leading-7 text-gray-600">This page links to the publisher’s news coverage. Islamic Online is an independent project and does not republish or imply endorsement of third-party reporting.</p>
      </header>
      <AdSlot position="in-article" slotId="1222556839" />
      <section class="rounded-2xl border border-emerald-100 bg-white p-6 shadow-sm">
        <h2 class="text-xl font-bold text-emerald-950">Read the latest from IslamicFinder</h2>
        <p class="mt-2 leading-7 text-gray-600">Visit the external news section for current stories and announcements. Check the original publisher for dates, sources, and updates.</p>
        <a href="https://www.islamicfinder.org/news/" rel="noopener noreferrer" target="_blank" class="mt-5 inline-flex rounded-xl bg-emerald-700 px-5 py-3 font-semibold text-white hover:bg-emerald-800">Open IslamicFinder News ↗</a>
      </section>
      <section class="rounded-2xl bg-emerald-50 p-6">
        <h2 class="text-lg font-bold text-emerald-950">Explore Islamic Online</h2>
        <div class="mt-4 flex flex-wrap gap-3">
          <a href={`${base}articles`} class="rounded-lg border border-emerald-200 bg-white px-4 py-2 font-medium text-emerald-800">Read our guides</a>
          <a href={`${base}calendar`} class="rounded-lg border border-emerald-200 bg-white px-4 py-2 font-medium text-emerald-800">View the Islamic calendar</a>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
