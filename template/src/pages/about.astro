---
import Header from '../components/Header.tsx';
import Footer from '../components/Footer.tsx';
import AdSlot from '../components/AdSlot.tsx';
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="description" content="Learn about Islamic Online, its Islamic tools, and how to contact the project team." />
    <title>About Us and Contact | Islamic Online</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  </head>
  <body>
    <Header client:load currentLang="en" />

    <main class="max-w-4xl mx-auto px-4 py-12">
      <div class="text-center mb-10">
        <h1 class="text-4xl font-extrabold text-emerald-900 dark:text-emerald-100 mb-4">About Islamic Online</h1>
        <p class="text-lg text-gray-600 dark:text-gray-400">A digital home for practical Islamic resources, reading, and everyday tools.</p>
      </div>

      <AdSlot position="in-article" slotId="1222556839" />

      <div class="article-content space-y-6">
        <h2>Our Mission</h2>
        <p>Islamic Online was founded with a singular vision: to leverage modern web technology to provide accurate, accessible, and beautifully designed Islamic tools and resources for Muslims worldwide. In an interconnected digital age, we strive to make daily acts of worship, Quranic study, and authentic knowledge effortless.</p>

        <h2>What We Offer</h2>
        <p>The site offers English educational content and ten-language translations for core navigation:</p>
        <ul>
          <li><strong>Reading:</strong> Quran chapter index, Hadith collection directory, duas, and introductory guides.</li>
          <li><strong>Daily tools:</strong> Estimated prayer times, Qibla direction, Hijri date conversion, and digital Tasbih.</li>
          <li><strong>Planning:</strong> An illustrative Zakat calculator and a yearly prayer schedule generator.</li>
        </ul>

        <div class="my-8">
          <AdSlot position="in-article" slotId="1222556839" />
        </div>

        <h2>Educational note</h2>
        <p>Translations and calculators are provided for general information and may not cover scholarly differences or local practice. Verify religious questions with qualified scholars and check local mosque sources for prayer times and dates.</p>
      </div>

      <section id="contact" class="mt-12 scroll-mt-24 rounded-2xl border border-emerald-100 bg-white p-6">
        <h2 class="text-2xl font-bold text-emerald-950">Contact us</h2>
        <p class="mt-2 text-gray-600">For feedback or to report a site issue, open a discussion in the project repository.</p>
        <a href="https://github.com/geturnet/islamic-online-app/issues" target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex rounded-xl bg-emerald-700 px-5 py-3 font-semibold text-white hover:bg-emerald-800">Contact the project ↗</a>
      </div>
      <div class="mt-12"><AdSlot position="footer" slotId="1222556839" /></div>
    </main>

    <Footer />
  </body>
</html>
