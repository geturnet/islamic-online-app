---
import Header from '../components/Header.tsx';
import Footer from '../components/Footer.tsx';
import AdSlot from '../components/AdSlot.tsx';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>About Us - Islamic Online</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>
  <body>
    <Header currentLang="en" />

    <main class="max-w-4xl mx-auto px-4 py-12">
      <div class="text-center mb-10">
        <h1 class="text-4xl font-extrabold text-emerald-900 dark:text-emerald-100 mb-4">About Islamic Online</h1>
        <p class="text-lg text-gray-600 dark:text-gray-400">Your trusted digital companion for daily Islamic practices and verified knowledge.</p>
      </div>

      <AdSlot position="in-article" slotId="about-top" />

      <div class="article-content space-y-6">
        <h2>Our Mission</h2>
        <p>Islamic Online was founded with a singular vision: to leverage modern web technology to provide accurate, accessible, and beautifully designed Islamic tools and resources for Muslims worldwide. In an interconnected digital age, we strive to make daily acts of worship, Quranic study, and authentic knowledge effortless.</p>

        <h2>What We Offer</h2>
        <p>We provide a comprehensive ecosystem of multi-language tools and content spanning across 10 global languages:</p>
        <ul>
          <li><strong>Al-Quran & Hadith:</strong> Verified texts, translations, and deep-dive scholarly articles.</li>
          <li><strong>Daily Essentials:</strong> Accurate Prayer Times, Qibla Direction, and Digital Tasbih.</li>
          <li><strong>Financial Tools:</strong> Precise Zakat Calculator to assist in fulfilling obligations.</li>
          <li><strong>Knowledge Hub:</strong> 100+ comprehensive articles and guides exploring Islamic jurisprudence, history, and spirituality.</li>
        </ul>

        <div class="my-8">
          <AdSlot position="in-article" slotId="about-middle" />
        </div>

        <h2>Our Commitment to Authenticity</h2>
        <p>All content and tools provided on Islamic Online are carefully reviewed to ensure alignment with authentic Islamic teachings. We are dedicated to continuous improvement and expanding our multi-lingual reach to serve Ummah across every corner of the globe.</p>
      </div>

      <div class="mt-12">
        <AdSlot position="footer" slotId="about-bottom" />
      </div>
    </main>

    <Footer />
  </body>
</html>
