---
import Header from '../../components/Header.tsx';
import Footer from '../../components/Footer.tsx';
import Sidebar from '../../components/Sidebar.tsx';
import AdSlot from '../../components/AdSlot.tsx';
import { ARTICLES } from '../../data/articles';
import '../../styles/global.css';

export function getStaticPaths() {
  return ARTICLES.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

const { article } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`;
const related = ARTICLES.filter((item) => article.related.includes(item.slug));
const canonical = new URL(`${base}articles/${article.slug}`, Astro.site).toString();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={article.description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={`${article.title} | Islamic Online`} />
    <meta property="og:description" content={article.description} />
    <meta property="og:image" content={article.image} />
    <title>{article.title} | Islamic Online</title>
  </head>
  <body class="min-h-screen bg-gray-50 text-gray-900">
    <Header client:load currentLang="en" />
    <main class="mx-auto max-w-7xl px-4 py-10">
      <div class="grid gap-8 lg:grid-cols-3">
        <article class="min-w-0 lg:col-span-2">
          <a href={`${base}articles`} class="font-semibold text-emerald-700 hover:underline">← All guides</a>
          <p class="mt-6 text-xs font-bold uppercase tracking-widest text-emerald-700">{article.category}</p>
          <h1 class="mt-2 text-3xl font-extrabold leading-tight text-emerald-950 md:text-5xl">{article.title}</h1>
          <p class="mt-4 text-lg leading-7 text-gray-600">{article.description}</p>
          <img src={article.image} alt="" class="mt-6 max-h-[460px] w-full rounded-2xl object-cover" fetchpriority="high" />
          <div class="article-content mt-8">
            {article.sections.map((section, index) => (
              <>
                <h2>{section.heading}</h2>
                {section.paragraphs.map((paragraph) => (
                  <p set:html={paragraph.replace(/\[([^\]]+)\]\(([^)]+)\)/g, `<a class="font-semibold text-emerald-700 underline" href="${base}$2">$1</a>`)} />
                ))}
                {index === 0 && <AdSlot position="in-article" slotId="1222556839" />}
              </>
            ))}
          </div>
          <section class="mt-10 border-t border-emerald-100 pt-8">
            <h2 class="text-2xl font-bold text-emerald-950">Related guides</h2>
            <div class="mt-4 grid gap-4 sm:grid-cols-2">
              {related.map((item) => (
                <a href={`${base}articles/${item.slug}`} class="rounded-xl border border-emerald-100 bg-white p-5 hover:border-emerald-400">
                  <span class="text-xs font-bold uppercase tracking-wider text-emerald-700">{item.category}</span>
                  <h3 class="mt-2 font-bold text-emerald-950">{item.title}</h3>
                  <p class="mt-2 text-sm text-gray-600">{item.description}</p>
                </a>
              ))}
            </div>
          </section>
        </article>
        <aside class="space-y-6">
          <AdSlot position="sidebar" slotId="1222556839" />
          <Sidebar />
        </aside>
      </div>
    </main>
    <Footer />
  </body>
</html>
