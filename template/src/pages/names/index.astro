---
import Header from '../../components/Header.tsx';
import Footer from '../../components/Footer.tsx';
import AdSlot from '../../components/AdSlot.tsx';
import { NAMES_99 } from '../../../../src/lib/data';
import '../../styles/global.css';

---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Browse the commonly presented list of the 99 Names of Allah with transliterations and a note on studying their meanings." />
    <title>Names of Allah | Islamic Online</title>
  </head>
  <body class="min-h-screen bg-gray-50 text-gray-900">
    <Header client:load currentLang="en" />
    <main class="mx-auto max-w-7xl space-y-8 px-4 py-10">
      <header class="max-w-3xl">
        <p class="font-semibold uppercase tracking-widest text-emerald-700">Asma ul Husna</p>
        <h1 class="mt-2 text-4xl font-extrabold text-emerald-950">The 99 Names of Allah</h1>
        <p class="mt-3 text-gray-600">Explore the commonly presented list of 99 names. Transliteration and ordering can differ between sources; consult reliable scholarship for meanings and context.</p>
      </header>
      <AdSlot position="in-article" slotId="1222556839" />
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {NAMES_99.map((name, index) => (
          <article class="flex items-center gap-4 rounded-2xl border border-emerald-100 bg-white p-5 shadow-sm">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-emerald-50 font-bold text-emerald-800">{index + 1}</span>
            <div>
              <h2 class="font-bold text-emerald-950">{name}</h2>
              <p class="text-sm text-gray-600">Read a trusted explanation and reflect on its meaning.</p>
            </div>
          </article>
        ))}
      </div>
    </main>
    <Footer />
  </body>
</html>
