---
import Header from '../components/Header.tsx';
import Footer from '../components/Footer.tsx';
import Sidebar from '../components/Sidebar.tsx';
import AdSlot from '../components/AdSlot.tsx';
import '../styles/global.css';
const base = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`;
const moreFeatures = [
  { title: 'Daily Dua', description: 'Common supplications with Arabic, transliteration, and meaning.', href: 'dua', icon: '🤲' },
  { title: 'Islamic Calendar', description: 'Explore the Hijri calendar and convert Gregorian dates.', href: 'calendar', icon: '🌙' },
  { title: '99 Names', description: 'Browse the commonly presented list of Asma ul Husna.', href: 'names', icon: '✨' },
  { title: 'Kalima', description: 'Read well-known declarations and words of remembrance.', href: 'kalima', icon: '📿' },
  { title: 'Knowledge', description: 'Read practical introductory guides on faith and worship.', href: 'articles', icon: '📚' },
  { title: 'Islamic Gallery', description: 'Browse images of study, worship, and architecture.', href: 'gallery', icon: '🖼️' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Islamic Online - Complete Islamic Digital Companion & Tools</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google-site-verification" content="OqhGdJ_aNXti-vQ-L4nOPadp7cBUMCbDlnKy21nQE3c" />
  </head>
  <body class="bg-gray-50 dark:bg-gray-950 text-gray-900 dark:text-gray-100">
    
    {/* Global Header with Language Selector & Nav */}
    <Header client:load currentLang="en" />

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      
      {/* Hero Section */}
      <div class="relative bg-gradient-to-r from-emerald-900 via-emerald-800 to-emerald-700 text-white rounded-3xl p-8 md:p-12 shadow-xl mb-12 overflow-hidden">
        <div class="absolute -right-10 -bottom-10 text-9xl opacity-10 font-arabic select-none pointer-events-none">
          ☪
        </div>
        <div class="max-w-2xl relative z-10">
          <span class="text-xs uppercase tracking-widest bg-emerald-800/80 px-3 py-1 rounded-full text-emerald-200 inline-block mb-4">
            Islamic Online
          </span>
          <h1 class="text-3xl md:text-5xl font-extrabold mb-4 leading-tight">
            Your Comprehensive Digital Islamic Companion
          </h1>
          <p class="text-emerald-100 text-base md:text-lg mb-8 leading-relaxed">
            Read Quran chapters, browse major Hadith collections, estimate daily prayer times, find the Qibla, and use everyday Islamic tools. Core navigation is available in ten languages.
          </p>
          <div class="flex flex-wrap gap-4">
            <a href={`${base}quran`} class="px-6 py-3 bg-white text-emerald-900 font-bold rounded-xl shadow-md hover:bg-emerald-50 transition">
              📖 Read Al-Quran
            </a>
            <a href={`${base}prayer-times`} class="px-6 py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl shadow-md transition border border-emerald-500">
              ⏰ Prayer Times
            </a>
          </div>
        </div>
      </div>

      {/* Hero Ad Slot */}
      <div class="mb-12">
        <AdSlot client:load position="in-article" slotId="1222556839" />
      </div>

      <div class="flex flex-col lg:flex-row gap-8">
        
        {/* Main Content Area */}
        <div class="flex-1 space-y-12">
          
          {/* Quick Access Grid / Features Section */}
          <section>
            <div class="flex items-center justify-between mb-6">
              <h2 class="text-2xl font-bold text-emerald-900 dark:text-emerald-100">
                Core Features & Services
              </h2>
              <span class="text-xs text-gray-400">Multi-language support (10 languages)</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              
              {/* Feature 1: Quran */}
              <a href={`${base}quran`} class="p-6 bg-white dark:bg-gray-900 rounded-2xl shadow-sm border border-emerald-100 dark:border-emerald-900 hover:border-emerald-500 transition group">
                <div class="w-12 h-12 bg-emerald-50 dark:bg-emerald-950 text-emerald-600 rounded-xl flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition">
                  📖
                </div>
                <h3 class="text-lg font-bold text-gray-800 dark:text-gray-100 mb-2">Al-Quran Al-Kareem</h3>
                <p class="text-sm text-gray-600 dark:text-gray-400">
                  Browse all 114 surahs with Arabic script and English translation.
                </p>
              </a>

              {/* Feature 2: Hadith */}
              <a href={`${base}hadith`} class="p-6 bg-white dark:bg-gray-900 rounded-2xl shadow-sm border border-emerald-100 dark:border-emerald-900 hover:border-emerald-500 transition group">
                <div class="w-12 h-12 bg-emerald-50 dark:bg-emerald-950 text-emerald-600 rounded-xl flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition">
                  📜
                </div>
                <h3 class="text-lg font-bold text-gray-800 dark:text-gray-100 mb-2">Authentic Hadiths</h3>
                <p class="text-sm text-gray-600 dark:text-gray-400">
                  Browse reference details for major Hadith collections, including Sahih al-Bukhari and Sahih Muslim.
                </p>
              </a>

              {/* Feature 3: Prayer Times */}
              <a href={`${base}prayer-times`} class="p-6 bg-white dark:bg-gray-900 rounded-2xl shadow-sm border border-emerald-100 dark:border-emerald-900 hover:border-emerald-500 transition group">
                <div class="w-12 h-12 bg-emerald-50 dark:bg-emerald-950 text-emerald-600 rounded-xl flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition">
                  ⏰
                </div>
                <h3 class="text-lg font-bold text-gray-800 dark:text-gray-100 mb-2">Accurate Prayer Times</h3>
                <p class="text-sm text-gray-600 dark:text-gray-400">
                  City and location-based prayer estimates, plus an optional yearly schedule.
                </p>
              </a>

              {/* Feature 4: Qibla Compass */}
              <a href={`${base}qibla`} class="p-6 bg-white dark:bg-gray-900 rounded-2xl shadow-sm border border-emerald-100 dark:border-emerald-900 hover:border-emerald-500 transition group">
                <div class="w-12 h-12 bg-emerald-50 dark:bg-emerald-950 text-emerald-600 rounded-xl flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition">
                  🕋
                </div>
                <h3 class="text-lg font-bold text-gray-800 dark:text-gray-100 mb-2">Qibla Direction</h3>
                <p class="text-sm text-gray-600 dark:text-gray-400">
                  Find the exact bearing and visual compass heading toward the Holy Kaaba in Mecca.
                </p>
              </a>

              {/* Feature 5: Zakat Calculator */}
              <a href={`${base}zakat-calculator`} class="p-6 bg-white dark:bg-gray-900 rounded-2xl shadow-sm border border-emerald-100 dark:border-emerald-900 hover:border-emerald-500 transition group">
                <div class="w-12 h-12 bg-emerald-50 dark:bg-emerald-950 text-emerald-600 rounded-xl flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition">
                  💰
                </div>
                <h3 class="text-lg font-bold text-gray-800 dark:text-gray-100 mb-2">Zakat Calculator</h3>
                <p class="text-sm text-gray-600 dark:text-gray-400">
                  Estimate Zakat on entered assets using a selected gold or silver nisab.
                </p>
              </a>

              {/* Feature 6: Digital Tasbih */}
              <a href={`${base}tasbih`} class="p-6 bg-white dark:bg-gray-900 rounded-2xl shadow-sm border border-emerald-100 dark:border-emerald-900 hover:border-emerald-500 transition group">
                <div class="w-12 h-12 bg-emerald-50 dark:bg-emerald-950 text-emerald-600 rounded-xl flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition">
                  📿
                </div>
                <h3 class="text-lg font-bold text-gray-800 dark:text-gray-100 mb-2">Digital Tasbih Counter</h3>
                <p class="text-sm text-gray-600 dark:text-gray-400">
                  Engage in daily Dhikr with interactive tap counters and customizable remembrance formulas.
                </p>
              </a>

            </div>
          </section>

          <section>
            <h2 class="mb-5 text-2xl font-bold text-emerald-900 dark:text-emerald-100">More to explore</h2>
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {moreFeatures.map((feature) => (
                <a href={`${base}${feature.href}`} class="rounded-2xl border border-emerald-100 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:border-emerald-400 hover:shadow-md">
                  <span class="text-2xl" aria-hidden="true">{feature.icon}</span>
                  <h3 class="mt-3 font-bold text-emerald-950">{feature.title}</h3>
                  <p class="mt-1 text-sm leading-6 text-gray-600">{feature.description}</p>
                </a>
              ))}
            </div>
          </section>

          {/* Middle Ad Slot */}
          <div class="my-8">
            <AdSlot client:load position="in-article" slotId="1222556839" />
          </div>

          {/* SEO Knowledge & Articles Section */}
          <section class="bg-white dark:bg-gray-900 p-8 rounded-3xl shadow-sm border border-emerald-100 dark:border-emerald-900">
            <h2 class="text-2xl font-bold text-emerald-900 dark:text-emerald-100 mb-4">
              Islamic Knowledge Hub & SEO Articles
            </h2>
            <p class="text-gray-600 dark:text-gray-400 leading-relaxed mb-6">
              Explore our growing collection of practical guides on Quran, worship, and Muslim daily life. Articles are written in English, with core navigation available in ten languages.
            </p>
            <div class="flex items-center space-x-4">
              <span class="text-xs font-bold uppercase tracking-widest text-emerald-600 bg-emerald-50 dark:bg-emerald-950 px-3 py-1 rounded-full">
                Knowledge library
              </span>
              <span class="text-xs font-bold uppercase tracking-widest text-emerald-600 bg-emerald-50 dark:bg-emerald-950 px-3 py-1 rounded-full">
                English articles
              </span>
            </div>
            <a href={`${base}articles`} class="mt-6 inline-flex rounded-xl bg-emerald-700 px-5 py-3 font-semibold text-white hover:bg-emerald-800">
              Explore the guides →
            </a>
          </section>

        </div>

        {/* Sidebar Area */}
        <Sidebar />

      </div>

    </main>

    {/* Comprehensive Footer */}
    <Footer />

  </body>
</html>
