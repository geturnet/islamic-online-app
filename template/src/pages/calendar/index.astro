---
import Header from '../../components/Header.tsx';
import Footer from '../../components/Footer.tsx';
import Sidebar from '../../components/Sidebar.tsx';
import CalendarWidget from '../../components/CalendarWidget.tsx';
import AdSlot from '../../components/AdSlot.tsx';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Islamic Calendar & Date Converter - Islamic Online</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>
  <body>
    <Header currentLang="en" />

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <div class="flex flex-col lg:flex-row gap-8">
        
        <!-- Main Content Area -->
        <div class="flex-1 space-y-8">
          <div class="text-center md:text-left">
            <h1 class="text-3xl font-extrabold text-emerald-900 dark:text-emerald-100 mb-2">
              Islamic Calendar & Date Converter (التقويم الهجري)
            </h1>
            <p class="text-gray-600 dark:text-gray-400">
              Track important Islamic lunar months, holidays, and convert Gregorian dates instantly.
            </p>
          </div>

          <!-- Interactive Calendar & Converter Widget -->
          <CalendarWidget client:load />

          <div class="article-content bg-white dark:bg-gray-900 p-6 rounded-2xl shadow-sm border border-emerald-100 dark:border-emerald-900">
            <h2>Understanding the Hijri Calendar</h2>
            <p>The Islamic (Hijri) calendar is a lunar calendar consisting of 12 months in a year of 354 or 355 days. It is used to determine the proper days of Islamic rituals and holidays, such as the annual fasting of Ramadan and the time of Hajj.</p>
            
            <div class="my-6">
              <AdSlot position="in-article" slotId="1222556839" />
            </div>

            <h3>The 12 Islamic Months</h3>
            <ul>
              <li><strong>1. Muharram</strong> (The Sacred Month)</li>
              <li><strong>2. Safar</strong></li>
              <li><strong>3. Rabi' al-Awwal</strong> (Month of the Prophet's Birth)</li>
              <li><strong>4. Rabi' al-Thani</strong> | <strong>5. Jumada al-Ula</strong> | <strong>6. Jumada al-Thani</strong></li>
              <li><strong>7. Rajab</strong> (Sacred Month) | <strong>8. Sha'ban</strong> (Precursor to Ramadan)</li>
              <li><strong>9. Ramadan</strong> (Month of Fasting)</li>
              <li><strong>10. Shawwal</strong> (Eid al-Fitr)</li>
              <li><strong>11. Dhu al-Qi'dah</strong> (Sacred Month)</li>
              <li><strong>12. Dhu al-Hijjah</strong> (Month of Hajj & Eid al-Adha)</li>
            </ul>
          </div>
        </div>

        <!-- Sidebar Area -->
        <Sidebar />

      </div>
    </main>

    <Footer />
  </body>
</html>
