---
import Header from '../../components/Header.tsx';
import Footer from '../../components/Footer.tsx';
import Sidebar from '../../components/Sidebar.tsx';
import AdSlot from '../../components/AdSlot.tsx';
import '../../styles/global.css';
const base = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`;

// Fungsi untuk membuat path statis untuk 114 Surah saat build
export async function getStaticPaths() {
  const response = await fetch('https://api.alquran.cloud/v1/surah');
  const data = await response.json();
  
  return data.data.map((surah: any) => ({
    params: { id: surah.number.toString() },
    props: { surahMeta: surah },
  }));
}

const { id } = Astro.params;
const { surahMeta } = Astro.props;

// Fetch data ayat untuk surah tertentu (Teks Arab Uthmani + Terjemahan English Sahih International)
const res = await fetch(`https://api.alquran.cloud/v1/surah/${id}/editions/quran-uthmani,en.sahih`);
const json = await res.json();

const arabicData = json.data[0];
const englishData = json.data[1];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Surah {arabicData.englishName} ({arabicData.name}) - Islamic Online</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  </head>
  <body>
    <Header client:load currentLang="en" />

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <div class="flex flex-col lg:flex-row gap-8">
        
        <!-- Main Content Area -->
        <div class="flex-1 space-y-8">
          
          {/* Surah Header Banner */}
          <div class="text-center bg-gradient-to-r from-emerald-900 to-emerald-700 text-white p-8 rounded-3xl shadow-lg relative overflow-hidden">
            <span class="text-6xl absolute -right-6 -bottom-6 opacity-10 font-arabic">☪</span>
            <span class="text-xs uppercase tracking-widest bg-emerald-800 px-3 py-1 rounded-full text-emerald-200 inline-block mb-3">
              Surah {arabicData.number} • {arabicData.revelationType} • {arabicData.numberOfAyahs} Ayahs
            </span>
            <h1 class="text-3xl md:text-5xl font-extrabold mb-2 font-arabic">
              {arabicData.name}
            </h1>
            <h2 class="text-xl font-semibold text-emerald-100">
              {arabicData.englishName} ({arabicData.englishNameTranslation})
            </h2>
          </div>

          {/* Bismillah Header (Kecuali Surah At-Tawbah / 9) */}
          {arabicData.number !== 9 && (
            <div class="text-center py-6 bg-white dark:bg-gray-900 rounded-2xl shadow-sm border border-emerald-100 dark:border-emerald-900">
              <p class="text-2xl md:text-3xl font-arabic text-emerald-900 dark:text-emerald-100">
                بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ
              </p>
            </div>
          )}

          {/* Ad Slot Above Ayahs */}
          <AdSlot client:load position="in-article" slotId="1222556839" />

          {/* Ayahs List Container */}
          <div class="space-y-4">
            {arabicData.ayahs.map((ayah: any, index: number) => (
              <div 
                key={ayah.number}
                class="p-6 bg-white dark:bg-gray-900 rounded-2xl shadow-sm border border-emerald-100/60 dark:border-emerald-900/60 hover:border-emerald-500 transition"
              >
                {/* Nomor Ayat & Tanda */}
                <div class="flex items-center justify-between mb-4 border-b border-gray-100 dark:border-gray-800 pb-3">
                  <span class="w-8 h-8 bg-emerald-50 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300 font-bold text-xs rounded-full flex items-center justify-center">
                    {ayah.numberInSurah}
                  </span>
                  <span class="text-xs text-gray-400">Ayah {ayah.numberInSurah} of {arabicData.numberOfAyahs}</span>
                </div>

                {/* Teks Arab */}
                <div class="text-right my-4">
                  <p class="text-2xl md:text-3xl font-arabic leading-loose text-gray-900 dark:text-gray-100">
                    {ayah.text}
                  </p>
                </div>

                {/* Terjemahan Bahasa Inggris */}
                <div class="mt-4 pt-4 border-t border-gray-100 dark:border-gray-800 text-left">
                  <p class="text-gray-700 dark:text-gray-300 text-base leading-relaxed">
                    {englishData.ayahs[index].text}
                  </p>
                </div>
              </div>
            ))}
          </div>

          {/* Ad Slot Below Ayahs */}
          <div class="mt-8">
            <AdSlot client:load position="footer" slotId="1222556839" />
          </div>

          {/* Bottom Navigation */}
          <div class="flex justify-between items-center pt-4">
            {arabicData.number > 1 ? (
              <a 
                href={`${base}quran/${arabicData.number - 1}`}
                class="px-5 py-3 bg-emerald-50 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300 font-semibold rounded-xl text-sm hover:bg-emerald-100 transition"
              >
                ← Previous Surah
              </a>
            ) : <div />}

            <a 
              href={`${base}quran`}
              class="px-5 py-3 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-200 font-semibold rounded-xl text-sm hover:bg-gray-200 transition"
            >
              📖 Back to Index
            </a>

            {arabicData.number < 114 ? (
              <a 
                href={`${base}quran/${arabicData.number + 1}`}
                class="px-5 py-3 bg-emerald-600 text-white font-semibold rounded-xl text-sm hover:bg-emerald-700 transition shadow-sm"
              >
                Next Surah →
              </a>
            ) : <div />}
          </div>

        </div>

        {/* Sidebar Area */}
        <Sidebar />

      </div>
    </main>

    <Footer />
  </body>
</html>
